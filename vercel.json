{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "generador-horarios": {
      "root": ".",
      "entrypoint": "app:app",
      "buildCommand": "pip install -r requirements.txt",
      "functions": {
        "app.py": {
          "maxDuration": 60,
          "includeFiles": "{static/**,horarios.db}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "generador-horarios"
      }
    }
  ]
}
